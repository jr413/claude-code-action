{
  "name": "real-gym-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:worker": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "d1:schema": "npx wrangler d1 execute real-gym-scheduler --remote --file=d1/schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  }
}
