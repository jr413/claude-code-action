# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the client.
# Used for admin actions (KYC approval, moderation) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Admin screen (Naoki-only) gate. ADMIN_SESSION_SECRET should be a long
# random string, unrelated to ADMIN_PASSWORD.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe (user Premium subscription — spec section 5.1). Shop plans are
# sales-led/invoice-based per spec 5.2 and managed from /admin/shops, not
# through this checkout flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (spec: PWA化). Generate with `npx web-push generate-vapid-keys`.
# Subscriptions are captured either way; actually sending push notifications
# is not wired up yet (needs a scheduled job — future work).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
